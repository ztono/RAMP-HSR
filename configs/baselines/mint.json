{
  "scope": "configuration_only",
  "task_adaptation": "aligned RAMP target_token_id without re-tokenizing target text",
  "max_context_tokens": 512,
  "padding_side": "left",
  "truncation_side": "left",
  "heldout_protocol": {
    "edit_samples": 2048,
    "edit_pool": "base_errors_only",
    "evaluation": "held-out error and preserve pools with no further editing",
    "persistent_updates": true
  },
  "oracle_protocol": "restore model weights between individual repair rows",
  "precision": "auto",
  "method": "MINT",
  "upstream_repository": "https://github.com/jianguda/mint",
  "upstream_commit": "324c0d8127d3e846828b20c355709b02139c1871",
  "profile": {
    "layer_policy": "upper_half",
    "candidate_neurons": 10,
    "max_patches": 5,
    "coefficient_floor": 0.001,
    "attribution": "target_label_input_times_gradient",
    "update": "semantic_traction",
    "ranking": "simulated_probability_gap_gain",
    "adaptive_coefficient": true,
    "rollback_on_failed_quota": true
  },
  "precision_resolution": {
    "cuda": "float16",
    "cpu": "float32"
  },
  "semantic_math_precision": "float32",
  "edit_seed": 0,
  "heldout_evaluation_seeds": [
    0,
    1
  ],
  "evaluation_export_fraction": 0.01,
  "evaluation_sampling": "natural_prevalence",
  "training_export": {
    "fraction": 0.1,
    "max_rows": 20000,
    "validation_fraction": 0.1
  },
  "eval_batch_size": 16,
  "alignment_check_samples": 1000,
  "min_alignment": 0.99
}
